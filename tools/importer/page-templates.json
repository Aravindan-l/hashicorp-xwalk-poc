{
  "metadata": {
    "projectType": "xwalk"
  },
  "templates": [
    {
      "name": "blog-article",
      "urls": [
        "https://www.hashicorp.com/en/blog/a-new-look-for-vagrant"
      ],
      "description": "HashiCorp blog article: breadcrumbs, title, intro, authors, tags and hero image in an Article Header block, followed by the article body as default content",
      "blocks": [
        {
          "name": "article-header",
          "instances": [
            "[class*='post_header']"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Article Header",
          "selector": [
            "[class*='post_header']"
          ],
          "style": null,
          "blocks": [
            "article-header"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Article Body",
          "selector": [
            "[class*='post_content']"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "p",
            "h2",
            "h3",
            "ul",
            "ol",
            "img",
            "blockquote",
            "pre"
          ]
        }
      ]
    },
    {
      "name": "homepage",
      "urls": [
        "https://www.hashicorp.com/en"
      ],
      "description": "HashiCorp homepage: hero, logo marquee, callout, split text/image sections, solution tabs, product groups, partners, certifications, resource tabs and a call-to-action band",
      "blocks": [
        {
          "name": "hero",
          "instances": [
            "main > div:has(> [class*='centered-text-hero_inner'])"
          ]
        },
        {
          "name": "logo-wall",
          "instances": [
            "main > div:has([class*='style_marquee'])",
            "main > div:has([class*='style_tile']) > [class*='style_root']"
          ]
        },
        {
          "name": "columns",
          "instances": [
            "main > div:has(> [class*='style_root'] > [class*='style_image'])"
          ]
        },
        {
          "name": "tabs",
          "instances": [
            "main > div:has([data-import-tabpanel] > h3)"
          ]
        },
        {
          "name": "cards",
          "instances": [
            "main > div:has([class*='style_categories'])",
            "main > div:has([data-import-tabpanel] > ul) [data-import-tabpanel]"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Hero",
          "selector": [
            "main > div:has(> [class*='centered-text-hero_inner'])"
          ],
          "style": null,
          "blocks": [
            "hero"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Customer logos",
          "selector": [
            "main > div:has([class*='style_marquee'])"
          ],
          "style": null,
          "blocks": [
            "logo-wall"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Callout",
          "selector": [
            "main > div:has([class*='base_callout'])"
          ],
          "style": "callout",
          "blocks": [],
          "defaultContent": [
            "p"
          ]
        },
        {
          "id": "section-4",
          "name": "Infrastructure Cloud",
          "selector": [
            "main > div:has(> [class*='style_center']:not([class*='style_reverse']):not([class*='style_isImageLarge']) > [class*='style_image'])"
          ],
          "style": null,
          "blocks": [
            "columns"
          ],
          "defaultContent": []
        },
        {
          "id": "section-5",
          "name": "HashiCorp Cloud Platform",
          "selector": [
            "main > div:has(> [class*='style_reverse'] > [class*='style_image'])"
          ],
          "style": null,
          "blocks": [
            "columns"
          ],
          "defaultContent": []
        },
        {
          "id": "section-6",
          "name": "Infragraph",
          "selector": [
            "main > div:has(> [class*='style_isImageLarge'])"
          ],
          "style": null,
          "blocks": [
            "columns"
          ],
          "defaultContent": []
        },
        {
          "id": "section-7",
          "name": "Solutions intro",
          "selector": [
            "main > div:has([class*='style_modularEyebrow'])"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "p",
            "h2"
          ]
        },
        {
          "id": "section-8",
          "name": "Solutions",
          "selector": [
            "main > div:has([data-import-tabpanel] > h3)"
          ],
          "style": null,
          "blocks": [
            "tabs"
          ],
          "defaultContent": []
        },
        {
          "id": "section-9",
          "name": "Lifecycle management intro",
          "selector": [
            "main > div:has([class*='style_heading'][class*='style_center'])"
          ],
          "style": "centered",
          "blocks": [],
          "defaultContent": [
            "h2",
            "p"
          ]
        },
        {
          "id": "section-10",
          "name": "Product groups",
          "selector": [
            "main > div:has([class*='style_categories'])"
          ],
          "style": "products",
          "blocks": [
            "cards"
          ],
          "defaultContent": []
        },
        {
          "id": "section-11",
          "name": "Partners",
          "selector": [
            "main > div:has([class*='style_tile'])"
          ],
          "style": "centered, logo-grid",
          "blocks": [
            "logo-wall"
          ],
          "defaultContent": [
            "p",
            "h2",
            "ul"
          ]
        },
        {
          "id": "section-12",
          "name": "Certifications",
          "selector": [
            "main > div:has(> [class*='style_start'] > [class*='style_image'])"
          ],
          "style": null,
          "blocks": [
            "columns"
          ],
          "defaultContent": []
        },
        {
          "id": "section-13",
          "name": "Resources and events",
          "selector": [
            "main > div:has([data-import-tabpanel] > ul)"
          ],
          "style": "tabs, featured-cards",
          "blocks": [
            "cards"
          ],
          "defaultContent": [
            "p",
            "h2",
            "h3"
          ]
        },
        {
          "id": "section-14",
          "name": "Call to action",
          "selector": [
            "main > div[class*='faint']"
          ],
          "style": "cta-band",
          "blocks": [],
          "defaultContent": [
            "h2",
            "p"
          ]
        }
      ]
    }
  ]
}
